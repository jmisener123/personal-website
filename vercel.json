{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/book", "destination": "/writing/books/", "permanent": true },
    {
      "source": "/book/:path*",
      "destination": "/writing/books/",
      "permanent": true
    },
    { "source": "/clips", "destination": "/writing/clips/", "permanent": true },
    {
      "source": "/clips/:path*",
      "destination": "/writing/clips/",
      "permanent": true
    },
    { "source": "/speechwriting", "destination": "/writing/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ]
}
